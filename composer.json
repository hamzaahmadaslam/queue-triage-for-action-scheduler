{
    "name": "hamzaahmadaslam/queue-triage-for-action-scheduler",
    "description": "A read-only report on the Action Scheduler queue for WordPress.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Hamza Ahmad Aslam",
            "homepage": "https://hamzaahmadaslam.com"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "7.4"
        }
    },
    "scripts": {
        "lint": "phpcs",
        "test": "phpunit"
    }
}
