<?xml version="1.0"?>
<ruleset name="Queue Triage for Action Scheduler">
	<description>WordPress Coding Standards and PHP 7.4 compatibility.</description>

	<file>./queue-triage-for-action-scheduler.php</file>
	<file>./uninstall.php</file>
	<file>./includes</file>
	<file>./tests</file>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>
	<arg name="colors"/>

	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.5"/>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="queue-triage-for-action-scheduler"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="QueueTriage"/>
				<element value="queue_triage"/>
			</property>
		</properties>
	</rule>

	<!-- Test files: fixtures and PHPUnit classes follow PHPUnit's naming, not WordPress file naming. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid">
		<exclude-pattern>tests/unit/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
		<exclude-pattern>tests/unit/bootstrap.php</exclude-pattern>
	</rule>
</ruleset>
